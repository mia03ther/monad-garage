# Copy this file to .env and fill values locally. Never commit real secrets.

# Required for signing deployments and transactions.
# Format: 0x followed by exactly 64 hexadecimal characters.
GENESIS_MONAD_PRIVATE_KEY=

# Public network configuration.
GENESIS_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
GENESIS_MONAD_WS_URL=wss://testnet-rpc.monad.xyz
GENESIS_MONAD_CHAIN_ID=10143
GENESIS_MONAD_EXPLORER_URL=https://testnet.monadexplorer.com

# Filled in after GenesisCommunity is deployed.
GENESIS_COMMUNITY_ADDRESS=
